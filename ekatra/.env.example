# ── Required ────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://ekatra:ekatra@localhost:5432/ekatra?schema=public"
# Long random string used to sign/hash session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=""
# Public base URL of the app (used in emails and links)
APP_URL="http://localhost:3000"

# ── Seed ────────────────────────────────────────────────────
# Password for the seeded team accounts (defaults to "Ekatra@2026" when empty — change in production!)
SEED_TEAM_PASSWORD=""

# ── Demo indicator ──────────────────────────────────────────
# "true" shows the DEMO DATA ribbon. Defaults to on outside production.
NEXT_PUBLIC_DEMO_MODE=""

# ── Email (optional) ────────────────────────────────────────
# When RESEND_API_KEY is empty, emails are written to the Outbox (Admin → Settings → Outbox) instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="Ekatra <hello@example.com>"

# ── WhatsApp Business (optional, not active) ───────────────
# Requires an approved WhatsApp Business provider and recorded WHATSAPP consent per buyer.
WHATSAPP_PROVIDER=""
WHATSAPP_API_KEY=""

# ── Maps ────────────────────────────────────────────────────
# Raster tile template for Leaflet. Default: CARTO Positron (free tier, attribution required, review CARTO terms for commercial use).
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors &copy; CARTO"

# ── Imagery ─────────────────────────────────────────────────
# "remote" loads illustrative photography from configured URLs; "plates" uses the built-in architectural artwork only.
NEXT_PUBLIC_IMAGE_MODE="remote"

# ── File storage ────────────────────────────────────────────
# Local directory used by the filesystem storage driver (dev). Swap the driver in src/lib/storage.ts for S3/R2 in production.
STORAGE_DIR="./storage"
