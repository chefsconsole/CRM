# ---- Core ----
# development | demo | staging | production
APP_ENV=development
PORT=4100

# ---- Database ----
# Required in production. Without it (non-production only) an embedded PGlite database is used.
# DATABASE_URL=postgres://hotelbridge:password@localhost:5432/hotelbridge
# PGLITE_DATA_DIR=.data/pglite

# ---- Sessions ----
SESSION_TTL_HOURS=12
# Defaults to true in production. Set false only for local http testing.
# COOKIE_SECURE=true

# ---- Public contact details (shown on the website, vouchers, proposals) ----
# Leave unset until verified; nothing is invented when blank.
# PUBLIC_CONTACT_EMAIL=
# PUBLIC_CONTACT_PHONE=

# ---- Inventory ----
SUPPLIER_TIMEOUT_MS=8000
OFFER_TTL_MINUTES=30
GROUP_RESPONSE_SLA_HOURS=24
# Simulated supplier for development/testing. Always disabled in production.
SANDBOX_SUPPLIER_ENABLED=true

# ---- Third-party suppliers (NOT CONNECTED — candidates only) ----
# Each needs a signed distribution agreement, API certification and an adapter implementation.
# TBO_API_URL= / TBO_USERNAME= / TBO_PASSWORD=
# HOTELBEDS_API_URL= / HOTELBEDS_API_KEY= / HOTELBEDS_SECRET=
# RATEHAWK_API_URL= / RATEHAWK_KEY_ID= / RATEHAWK_API_KEY=
