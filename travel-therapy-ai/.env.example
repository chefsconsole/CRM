# ---- Core ----
NODE_ENV=development
PORT=4000

# ---- Database ----
# Local: mongodb://127.0.0.1:27017/travel_therapy
# Atlas: mongodb+srv://<user>:<pass>@cluster/travel_therapy
MONGODB_URI=mongodb://127.0.0.1:27017/travel_therapy

# ---- Anthropic ----
# Get a key at https://console.anthropic.com/ — or run `ant auth login`.
ANTHROPIC_API_KEY=

# Model used by the AI employees. Defaults to claude-opus-5.
AI_MODEL=claude-opus-5
# Cheaper model for high-volume content/social generation (optional).
AI_CONTENT_MODEL=claude-sonnet-5

# ---- Company identity (used in prompts, quotes, outreach) ----
COMPANY_NAME=Travel Therapy
COMPANY_CURRENCY=INR
COMPANY_TIMEZONE=Asia/Kolkata

# ---- Webhook shared secret (Instagram / website form ingestion) ----
WEBHOOK_SECRET=change-me
