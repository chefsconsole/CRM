{
  "name": "travel-therapy-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-first luxury travel company platform (B2C) — lead capture, itinerary generation, quotations, and follow-up powered by Claude.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
